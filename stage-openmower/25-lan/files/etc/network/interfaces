auto lo
iface lo inet loopback

# AH20250831 Multiple IPs/net-device are also possible with other managers,
#   but the DHCP client may reset eth0 after a couple of failed tries. By this
#   it looses the internal LAN IP.
#   Remember: CM4's LAN interface has always a carrier because it's wired with
#   xCore's switch and not the LAN plug on the carrier board.

auto eth0

# Static internal robot ethernet
iface eth0 inet static
    address 172.16.78.1/24

# Home ethernet via DHCP
iface eth0 inet dhcp
